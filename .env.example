# ==========================================
# VARIÁVEIS DE AMBIENTE - DRA. JOSIMARA LIMA
# ==========================================

# URL do Webhook do Make (integração server-side com Google Sheets)
MAKE_WEBHOOK_URL=

# Número oficial do WhatsApp para redirecionamento após preenchimento (apenas dígitos: DDI + DDD + Número)
# Exemplo: 5587991655434
NEXT_PUBLIC_WHATSAPP_NUMBER=5587991655434

# Google Tag Manager Container ID (ex: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# URL Base da aplicação (ex: https://drajosimara.com.br)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
